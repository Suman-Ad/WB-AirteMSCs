rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAppUser() {
      return request.auth != null
        && request.auth.uid != 'n89Dopqa4ybdE8VX6B5zUwJYMcx1';
    }
    function isActiveSiteUser(siteId) {
      return isAppUser()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.siteId == siteId;
    }
    function isSiteAdmin(siteId) {
      return isActiveSiteUser(siteId)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Super Admin', 'Admin'];
    }
    function canViewAllLiveMeters() {
      return isAppUser()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Super Admin', 'Admin', 'Super User', 'User'];
    }
    function isActiveAdmin() {
      return isAppUser()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Super Admin', 'Admin'];
    }
    // Retain the supplied legacy access for non-energyMonitor collections.
    // All-sites reports use explicit paths so they do not query energyMonitor.
    match /{collection}/{document=**} {
      allow read, write: if isAppUser() && !(collection in ['energyMonitor', 'energyChangeovers', 'notificationDevices', 'notificationPreferences', 'notificationDeliveries', 'telegramLinks', 'telegramChats']);
    }
    match /notificationDevices/{token} {
      allow read, delete: if isAppUser() && resource.data.uid == request.auth.uid;
      allow create, update: if isAppUser()
        && request.resource.data.keys().hasOnly(['uid', 'token', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token == token
        && request.resource.data.updatedAt == request.time
        && (resource == null || resource.data.uid == request.auth.uid);
    }
    match /notificationPreferences/{uid} {
      allow read: if isAppUser() && request.auth.uid == uid;
      // Telegram linking and opt-out are handled by authenticated server functions.
      allow write: if false;
    }
    match /energyMonitor/{siteId}/meters/{meterId} {
      allow read: if isActiveSiteUser(siteId) || isActiveAdmin() || canViewAllLiveMeters();
      allow create, update: if request.auth != null
        && request.auth.uid == 'n89Dopqa4ybdE8VX6B5zUwJYMcx1'
        && siteId == 'N19106A'
        && (meterId == 'test-meter' || meterId.matches('meter-[0-9]{1,3}'))
        && request.resource.data.siteId == siteId
        && request.resource.data.meterId == meterId
        && request.resource.data.observedAt is timestamp
        && request.resource.data.status in ['OK', 'ERROR']
        && request.resource.data.powerUnits in ['raw', 'base', 'kilo'];
      allow delete: if isActiveAdmin();
    }
    // Independent server detector. Client access never grants runtime/history writes.
    match /energyMonitor/{siteId}/config/serverPowerSwitch {
      allow read: if isActiveSiteUser(siteId) || isActiveAdmin();
      allow create, update: if isActiveAdmin()
        && request.resource.data.keys().hasOnly(['enabled', 'mainMeterId', 'dg1MeterId', 'dg2MeterId', 'updatedBy', 'updatedAt'])
        && request.resource.data.enabled is bool
        && request.resource.data.mainMeterId is string
        && request.resource.data.dg1MeterId is string
        && request.resource.data.dg2MeterId is string
        && request.resource.data.mainMeterId != ''
        && (request.resource.data.dg1MeterId != '' || request.resource.data.dg2MeterId != '')
        && request.resource.data.mainMeterId != request.resource.data.dg1MeterId
        && request.resource.data.mainMeterId != request.resource.data.dg2MeterId
        && (request.resource.data.dg1MeterId == '' || request.resource.data.dg1MeterId != request.resource.data.dg2MeterId)
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /energyMonitor/{siteId}/runtime/serverPowerSource {
      allow read: if isActiveSiteUser(siteId) || isActiveAdmin();
      allow write: if false;
    }
    match /energyMonitor/{siteId}/serverChangeovers/{runId} {
      allow read: if isActiveSiteUser(siteId) || isActiveAdmin();
      allow write: if false;
    }
    match /energyMonitor/{siteId}/config/powerSwitch {
      allow read: if isActiveSiteUser(siteId) || isActiveAdmin();
      allow create, update: if (isActiveAdmin() || (isActiveSiteUser(siteId)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Super User'))
        && request.resource.data.keys().hasOnly(['enabled', 'mainMeterId', 'htMeterId', 'dg1MeterId', 'dg2MeterId', 'updatedBy', 'updatedAt'])
        && request.resource.data.enabled is bool
        && request.resource.data.mainMeterId is string
        && request.resource.data.htMeterId is string
        && request.resource.data.dg1MeterId is string
        && request.resource.data.dg2MeterId is string
        && (request.resource.data.mainMeterId == '' || (request.resource.data.mainMeterId != request.resource.data.dg1MeterId && request.resource.data.mainMeterId != request.resource.data.dg2MeterId))
        && (request.resource.data.dg1MeterId == '' || request.resource.data.dg1MeterId != request.resource.data.dg2MeterId)
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /energyMonitor/{siteId}/config/notifications {
      allow read: if isActiveSiteUser(siteId) || isActiveAdmin();
      allow create, update: if isActiveAdmin()
        && request.resource.data.keys().hasOnly(['enabled', 'dailyEnabled', 'changeoverEnabled', 'healthAlertsEnabled', 'recoveryAlertsEnabled', 'crqRemindersEnabled', 'telegramMetersEnabled', 'telegramFuelEnabled', 'telegramLoadEnabled', 'telegramPueEnabled', 'telegramSegrEnabled', 'telegramSiteStatusEnabled', 'telegramActivityEnabled', 'telegramIncidentEnabled', 'telegramCrqImportEnabled', 'intervalMinutes', 'updatedBy', 'updatedAt'])
        && request.resource.data.enabled is bool
        && (!('dailyEnabled' in request.resource.data) || request.resource.data.dailyEnabled is bool)
        && (!('changeoverEnabled' in request.resource.data) || request.resource.data.changeoverEnabled is bool)
        && (!('healthAlertsEnabled' in request.resource.data) || request.resource.data.healthAlertsEnabled is bool)
        && (!('recoveryAlertsEnabled' in request.resource.data) || request.resource.data.recoveryAlertsEnabled is bool)
        && (!('crqRemindersEnabled' in request.resource.data) || request.resource.data.crqRemindersEnabled is bool)
        && (!('telegramMetersEnabled' in request.resource.data) || request.resource.data.telegramMetersEnabled is bool)
        && (!('telegramFuelEnabled' in request.resource.data) || request.resource.data.telegramFuelEnabled is bool)
        && (!('telegramLoadEnabled' in request.resource.data) || request.resource.data.telegramLoadEnabled is bool)
        && (!('telegramPueEnabled' in request.resource.data) || request.resource.data.telegramPueEnabled is bool)
        && (!('telegramSegrEnabled' in request.resource.data) || request.resource.data.telegramSegrEnabled is bool)
        && (!('telegramSiteStatusEnabled' in request.resource.data) || request.resource.data.telegramSiteStatusEnabled is bool)
        && (!('telegramActivityEnabled' in request.resource.data) || request.resource.data.telegramActivityEnabled is bool)
        && (!('telegramIncidentEnabled' in request.resource.data) || request.resource.data.telegramIncidentEnabled is bool)
        && (!('telegramCrqImportEnabled' in request.resource.data) || request.resource.data.telegramCrqImportEnabled is bool)
        && request.resource.data.intervalMinutes in [30, 60, 120, 240, 360, 720, 1440]
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /energyMonitor/{siteId}/config/loadBook {
      allow read: if isActiveSiteUser(siteId);
      allow create, update: if isSiteAdmin(siteId)
        && request.resource.data.keys().hasOnly(['enabled', 'lt1MeterId', 'lt2MeterId', 'siteName', 'updatedAt'])
        && request.resource.data.enabled is bool
        && request.resource.data.lt1MeterId is string
        && request.resource.data.lt2MeterId is string
        && (!request.resource.data.enabled || (request.resource.data.lt1MeterId != '' && request.resource.data.lt2MeterId != '' && request.resource.data.lt1MeterId != request.resource.data.lt2MeterId))
        && request.resource.data.siteName is string
        && request.resource.data.updatedAt == request.time;
    }
    match /energyMonitor/{siteId}/config/meterHistory {
      allow read: if isActiveSiteUser(siteId) || isActiveAdmin();
      allow create, update: if isActiveAdmin()
        && request.resource.data.keys().hasOnly(['enabled', 'retentionDays', 'updatedBy', 'updatedAt'])
        && request.resource.data.enabled is bool
        && request.resource.data.retentionDays is int
        && request.resource.data.retentionDays >= 7
        && request.resource.data.retentionDays <= 365
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /energyMonitor/{siteId}/dailyReadings/{dayId} {
      allow read: if isActiveSiteUser(siteId) || isActiveAdmin();
      // Only the Admin SDK capture function creates or changes saved history.
      allow write: if false;
    }
    match /energyMonitor/{siteId}/historyMeters/{meterKey} {
      allow read: if isActiveSiteUser(siteId) || isActiveAdmin();
      allow write: if false;
      match /samples/{sampleId} {
        allow read: if isActiveSiteUser(siteId) || isActiveAdmin();
        allow write: if false;
      }
    }
    match /energyMonitor/{siteId}/config/sld {
      allow read: if isActiveSiteUser(siteId);
      allow create, update: if isSiteAdmin(siteId)
        && request.resource.data.keys().hasOnly(['version', 'payloadJson', 'updatedAt'])
        && request.resource.data.version == 1
        && request.resource.data.payloadJson is string
        && request.resource.data.payloadJson.size() <= 900000
        && request.resource.data.updatedAt == request.time;
      allow delete: if isSiteAdmin(siteId);
    }
    match /energyChangeovers/{siteId}/runs/{runId} {
      allow read: if isActiveSiteUser(siteId);
      function validRun() {
        return request.resource.data.keys().hasOnly(['siteId', 'siteName', 'dgNumber', 'meterId', 'mainMeterId', 'status', 'startAtMs', 'endAtMs', 'date', 'opening', 'latest', 'closing', 'ebFailure', 'ebRestoration', 'generationKwh', 'trigger', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt', 'runSeconds', 'counterReset', 'loadTransferAtMs', 'cooldownStartAtMs', 'cooldownEndAtMs', 'cooldownSeconds', 'cooldownStatus'])
          && request.resource.data.siteId == siteId
          && request.resource.data.status in ['Running', 'Completed']
          && request.resource.data.dgNumber is string
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
      }
      allow create: if isActiveSiteUser(siteId) && validRun()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isActiveSiteUser(siteId) && validRun()
        && resource.data.status == 'Running'
        && request.resource.data.status in ['Running', 'Completed']
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.startAtMs == resource.data.startAtMs
        && request.resource.data.opening == resource.data.opening
        && request.resource.data.meterId == resource.data.meterId;
      allow delete: if false;
    }
  }
}
